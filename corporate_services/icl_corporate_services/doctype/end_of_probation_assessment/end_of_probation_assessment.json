   "fieldname": "intro_html",
   "fieldtype": "HTML",
   "options": "<h4>ICL End of Probation Assessment Form</h4><p><b>Confidential HR Record | 3-Month Probation Review</b></p><p><b>Purpose:</b> To assess whether the employee has demonstrated sufficient role readiness, conduct, reliability, learning ability, and organisational fit for confirmation after the 3-month probation period. Ratings should be supported by brief evidence and discussed fairly with the employee.</p>"
  },
