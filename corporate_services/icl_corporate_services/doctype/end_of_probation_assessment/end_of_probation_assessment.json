  {
   "fieldname": "decision_rules_html",
   "fieldtype": "HTML",
   "options": "<table class=\"table table-bordered\"><thead><tr><th>Total Score</th><th>Percentage</th><th>Probation Result</th><th>Recommended Outcome Guide</th></tr></thead><tbody><tr><td>40 - 50</td><td>80% - 100%</td><td>Meets / exceeds probation standard</td><td>Confirmed</td></tr><tr><td>30 - 39</td><td>60% - 78%</td><td>Meets minimum standard but requires structured follow-up</td><td>Confirmed with Development Plan</td></tr><tr><td>0 - 29</td><td>0% - 58%</td><td>Does not meet probation confirmation standard</td><td>Not Confirmed</td></tr><tr><td>Critical concern</td><td>N/A</td><td>Serious issue in conduct, confidentiality, attendance, reliability, or role fit</td><td>HR review required regardless of total score</td></tr></tbody></table>"
