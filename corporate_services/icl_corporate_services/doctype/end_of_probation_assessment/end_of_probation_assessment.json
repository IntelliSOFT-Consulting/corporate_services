  {
   "fieldname": "guidance_section",
   "fieldtype": "Section Break",
   "label": "2. Probation Review Guidance"
  },
  {
   "fieldname": "guidance_html",
   "fieldtype": "HTML",
   "options": "<table class=\"table table-bordered\"><tbody><tr><td><b>Assessment period</b></td><td>This form is for the end of the 3-month probation period.</td></tr><tr><td><b>Evidence required</b></td><td>Ratings should be based on work outputs, observed behaviour, attendance, feedback records, and examples from the probation period.</td></tr><tr><td><b>Fairness check</b></td><td>Before a negative decision is made, HR should confirm that concerns were communicated, reasonable support was provided, and the employee had an opportunity to respond.</td></tr><tr><td><b>HR involvement</b></td><td>HR should be present where there are concerns, including Confirmed with Development Plan, Not Confirmed, Critical Concern, or disputed recommendations.</td></tr><tr><td><b>Decision principle</b></td><td>The score guides the recommendation, but the final decision must consider role requirements, critical conduct issues, support provided, and HR review.</td></tr><tr><td><b>Appeal / written response</b></td><td>Where the employee disagrees with a Confirmed with Development Plan, Not Confirmed, or Critical Concern outcome, the employee may submit a written response or appeal to HR within five (5) working days after the outcome is communicated.</td></tr></tbody></table>"
  },
  {
   "fieldname": "rating_scale_section",
   "fieldtype": "Section Break",
   "label": "3. Probation Rating Scale"
  },
  {
   "fieldname": "rating_scale_html",
   "fieldtype": "HTML",
   "options": "<table class=\"table table-bordered\"><thead><tr><th>Rating</th><th>Probation Standard</th><th>Description</th></tr></thead><tbody><tr><td>1</td><td>Not demonstrated</td><td>Performance, conduct, reliability, or role fit is significantly below the minimum standard for confirmation.</td></tr><tr><td>2</td><td>Partially demonstrated</td><td>Some ability is present, but performance is inconsistent or requires close supervision beyond what is expected at this stage.</td></tr><tr><td>3</td><td>Meets probation standard</td><td>The employee has demonstrated acceptable capability and behaviour for confirmation in the role.</td></tr><tr><td>4</td><td>Strong</td><td>The employee is dependable, learns quickly, works with limited supervision, and contributes positively.</td></tr><tr><td>5</td><td>Exceptional</td><td>The employee consistently exceeds the expected probation standard and shows strong ownership, judgement, and impact.</td></tr></tbody></table>"
  },
  {
   "description": "Rate each area from 1 to 5 and provide brief evidence. A rating of 3 is the minimum confirmation standard. Maximum score: 50.",
   "fieldname": "assessment_section",
   "fieldtype": "Section Break",
   "label": "4. Supervisor Probation Assessment"
  },
